% waihona.sty -- print archive.org snapshots next to cited URLs.
%   \aurl[id]{url}        -> \url{url} (accessed 13 November 2026; archived 18 October 2026)
%   \ahref[id]{url}{text} -> \href{url}{text} [archived 18 October 2026]
% Dates are always 'D Month YYYY'. 'archived <date>' is the hyperlink to the snapshot.
% Data comes from waihona.def (generated by waihona.py apply).
% Works with BibTeX and biber; for bibliography entries see README
% (bst/apalike-url-archive.bst, or tex/waihona-biblatex.tex).
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{waihona}[2026/11/13 archive.org links]
\RequirePackage{url}
\RequirePackage{hyperref}
\def\waihonaadd#1#2#3#4{%
  \expandafter\gdef\csname waih@d@#1\endcsname{#2}%
  \expandafter\gdef\csname waih@t@#1\endcsname{#3}%
  \expandafter\gdef\csname waih@u@#1\endcsname{#4}}
\def\waihona@load{%
  \IfFileExists{waihona.def}{%
    \begingroup
      \catcode`\#=12 \catcode`\%=12 \catcode`\~=12 \catcode`\_=12 \catcode`\&=12
      \catcode`\^=12 \catcode`\$=12
      \input{waihona.def}%
    \endgroup}{\PackageWarning{waihona}{waihona.def not found; run waihona.py apply --write}}}
\AtBeginDocument{\waihona@load}
\newcommand\waihona@link[1]{%
  \@ifundefined{waih@u@#1}%
    {\PackageWarning{waihona}{no snapshot for id #1}}%
    {\href{\csname waih@u@#1\endcsname}{archived \csname waih@t@#1\endcsname}}}
\newcommand\aurl[2][]{\url{#2}%
  \@ifundefined{waih@u@#1}{}%
    {\ (accessed \csname waih@d@#1\endcsname; \waihona@link{#1})}}
\newcommand\ahref[3][]{\href{#2}{#3}%
  \@ifundefined{waih@u@#1}{}{\ [\waihona@link{#1}]}}
\endinput
